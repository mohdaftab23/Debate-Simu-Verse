# Gemini API Key (Required for live multi-agent counterfactual reasoning)
GEMINI_API_KEY=

# Optional Multi-Key pool for high-throughput distributed agent execution
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Gemini Models
MODEL_NAME=gemini-3.7-flash
SYNTHESIS_MODEL_NAME=gemini-3.7-flash

# Simulation Mode (Set to "true" to force autonomous neural fallback mode)
MOCK_MODE=false

# Server Port
PORT=3000
