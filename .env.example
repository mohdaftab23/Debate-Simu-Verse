# GEMINI_API_KEY: Default Gemini API Key (injected by AI Studio)
GEMINI_API_KEY=""

# Optional Multi-Key pool (Agent 1-4 dedicated keys or fallback rotation)
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""

# Gemini Model Name (default: gemini-3.7-flash for debate & research, gemini-3.1-pro-preview for synthesis)
MODEL_NAME="gemini-3.7-flash"
SYNTHESIS_MODEL_NAME="gemini-3.7-flash"

# MOCK_MODE: Set to "true" to test without consuming API tokens or when keys are missing
MOCK_MODE="false"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
